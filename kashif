WORDLIST_DIR="/usr/share/wordlists"
DEFAULT_WORDLIST="$WORDLIST_DIR/rockyou.txt"
HASHCAT=$(command -v hashcat)
HASHID=$(command -v hashid)

declare -A HASH_MODES=(
    ["md5"]=0
    ["sha1"]=100
    ["sha256"]=1400
    ["sha512"]=1700
    ["ntlm"]=1000
)

